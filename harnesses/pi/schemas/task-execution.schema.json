{
  "type": "object",
  "required": ["goal", "repository", "baseSha", "acceptanceCriteria", "approvalGates"],
  "properties": {
    "goal": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "baseSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "writeAllowed": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "writeForbidden": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "approvalGates": {
      "type": "object", "required": ["scope", "completion"],
      "properties": { "scope": { "const": true }, "completion": { "const": true } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
